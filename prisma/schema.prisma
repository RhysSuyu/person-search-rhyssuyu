generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Person {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  age       Int?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
